      "class_row_html": "<tr>\n<td class=\"num\">48</td>\n<td>\n<img alt=\"\" height=\"22\" src=\"/static/icons/cry-of-prowess.webp\" style=\"vertical-align:-5px;margin-right:6px\" width=\"22\"/>\n<a href=\"/abilities/cry-of-prowess\">Cry of Prowess</a>\n</td>\n<td class=\"muted\"></td>\n<td class=\"num muted\">\n              126\n            </td>\n<td class=\"muted\">Instant</td>\n<td class=\"num muted\"></td>\n<td class=\"muted\">All allies instantly reach the highest level of their forms ( DC , Stalk , Ranger, BU , Bard)</td>\n</tr>",
