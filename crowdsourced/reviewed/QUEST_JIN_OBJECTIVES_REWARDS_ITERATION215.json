      "observations": [
        {
          "label": "Objectives",
          "text": "Absorb the Four Manifestations",
          "html": "<div class=\"tooltip\">Absorb the Four Manifestations</div>",
          "variant": false
        },
        {
          "label": "Description",
          "text": "1) Speak to Master Tallon Darkfist in Tanvu. You must collect a few manifestations.\n2) Turn so the water if on your left and the land is on your right, and start running along the coast. You will almost immediately run into the second manifestation, Liquid Essence of Jin, that wanders along the coastline. (-4478, -73853, +227)\n3) Keep running in the same direction and you will run into a gazebo like structure. In the middle of the gazebo is the first manifestation. (-8876, -76338, +1449).\n4) Head directly north-northeast and about 2/3 of the way up the hill in a very small building, you'll find the fourth manifestation. (-935, -91864, +1861).\n5) Head west-northwest and over the far side you will find a circular group of pylons. In the middle of there is the third manifestation. (-25671, -86395, +2489)\n6) Return to Master Tallon Darkfist in Tanvu for your reward.",
          "html": "<div class=\"tooltip\">1) Speak to Master Tallon Darkfist in Tanvu. You must collect a few manifestations.\n2) Turn so the water if on your left and the land is on your right, and start running along the coast. You will almost immediately run into the second manifestation, Liquid Essence of Jin, that wanders along the coastline. (-4478, -73853, +227)\n3) Keep running in the same direction and you will run into a gazebo like structure. In the middle of the gazebo is the first manifestation. (-8876, -76338, +1449).\n4) Head directly north-northeast and about 2/3 of the way up the hill in a very small building, you'll find the fourth manifestation. (-935, -91864, +1861).\n5) Head west-northwest and over the far side you will find a circular group of pylons. In the middle of there is the third manifestation. (-25671, -86395, +2489)\n6) Return to Master Tallon Darkfist in Tanvu for your reward.</div>",
          "variant": false
        },
        {
          "label": "Notes",
          "text": "Master Tallon Darkfist roams near the beach.\nYou have to hail the essence to advance the quest. This does not need to be in exact order.\nFlowing Essence of Jin -8715, -76174, 1450 in Tanvu (-19, 6) - in a Gazebo.\nLiquid Essence of Jin -1844, -78464, 176 in Tanvu (-19, 6) - on the beach.\nForest Essence of Jin -26678, -87056, 2429 in Tanvu (-19, 6) - in a circle of standing stones.\nFiery Essences of Jin -806, -92205, 1868 in Tanvu (-19, 6) - in a little shrine.",
          "html": "<p class=\"muted\">Master Tallon Darkfist roams near the beach.\nYou have to hail the essence to advance the quest. This does not need to be in exact order.\nFlowing Essence of Jin -8715, -76174, 1450 in Tanvu (-19, 6) - in a Gazebo.\nLiquid Essence of Jin -1844, -78464, 176 in Tanvu (-19, 6) - on the beach.\nForest Essence of Jin -26678, -87056, 2429 in Tanvu (-19, 6) - in a circle of standing stones.\nFiery Essences of Jin -806, -92205, 1868 in Tanvu (-19, 6) - in a little shrine.</p>",
          "variant": false
        },
        {
          "label": "Objectives as recorded by fandom",
          "text": "Absorb the First Manifestation\nAbsorb the Second Manifestation\nAbsorb the Third Manifestation\nAbsorb the Fourth Manifestation\nHollow Faded Crystal (1)",
          "html": "<div class=\"tooltip\">Absorb the First Manifestation\nAbsorb the Second Manifestation\nAbsorb the Third Manifestation\nAbsorb the Fourth Manifestation\nHollow Faded Crystal (1)</div>",
          "variant": true
        },
