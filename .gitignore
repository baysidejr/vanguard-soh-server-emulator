# This repo lives inside a Vanguard: Saga of Heroes client install.
# Allow-list: ignore everything, then allow only the emulator's own files.
# Game client files are copyrighted by SOE/Daybreak and must never be committed.
/*
!/.gitignore
!/.github/
!/LICENSE
!/README.md
!/PROGRESS.md
!/crowdsourced/
!/docs/
!/server/
!/tools/

# Local runtime data
/server/characters.json
/server/accounts.json
/server/guilds.json
/server/brotherhoods.json
/server/stub_log.txt
/server/__pycache__/
*.pyc
/server/mail.json
/server/market.json
/server/bug_reports.json
/server/player_reports.json
/server/quest_feedback.json
/server/housing.json
/server/caravans.json
/server/civic.json
/server/*.json.tmp
/server/vanguard.db*
/server/*.imported
/server/export/
/server/backups/
/server/proposals/
/server/audit.log
# TLS keys and certificates (never committed)
*.key
*.pem
*.crt
/server/smoke_log.txt
/server/check_log.txt
/server/client_ui_log.txt
/server/check_unit_failure.txt
