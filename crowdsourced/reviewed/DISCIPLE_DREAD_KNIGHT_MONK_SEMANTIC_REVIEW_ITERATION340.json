      "prose_evidence": [
        {
          "block_index": 0,
          "tag": "p",
          "text_as_printed": "Learned abilities are ones that are picked up when fighting mobs.",
          "source_html": "<p>Learned abilities are ones that are picked up when fighting mobs.</p>",
          "preceding_heading": null,
          "review_status": "pending_semantic_review",
          "game_fact": false
        },
        {
          "block_index": 1,
          "tag": "li",
          "text_as_printed": "Cull I can be learned from at least two different locations: Coterie Infineum Sanctuary (CIS). Fight the Infineum Guardians in the Ageless One Tower. Trengal Keep. Enter through the sewer on the east wall and fight the Death Knights.",
          "source_html": "<li>Cull I can be learned from at least two different locations:\n<ol>\n<li>Coterie Infineum Sanctuary (CIS). Fight the Infineum Guardians in the Ageless One Tower.</li>\n<li>Trengal Keep. Enter through the sewer on the east wall and fight the Death Knights.</li>\n</ol>\n</li>",
          "preceding_heading": "Cull",
          "review_status": "pending_semantic_review",
          "game_fact": false
        },
        {
          "block_index": 2,
          "tag": "li",
          "text_as_printed": "Cull II is learned in Greystone, in Blessing One, from Risen Attendants inside the jail cells.",
          "source_html": "<li>Cull II is learned in Greystone, in Blessing One, from Risen Attendants inside the jail cells.</li>",
          "preceding_heading": "Cull",
          "review_status": "pending_semantic_review",
          "game_fact": false
        },
        {
          "block_index": 3,
          "tag": "li",
          "text_as_printed": "Cull III is learned in Rhaz Inkur. Fight Efreeti Champions (only the ones with the ornate robe/headdress give updates!)",
          "source_html": "<li>Cull III is learned in Rhaz Inkur. Fight Efreeti Champions (only the ones with the ornate robe/headdress give updates!)</li>",
          "preceding_heading": "Cull",
          "review_status": "pending_semantic_review",
          "game_fact": false
        },
        {
          "block_index": 4,
          "tag": "li",
          "text_as_printed": "Ancient Word of Doom is learned in the APW Library Wing. Fight Dread Lords Malazath and Tiraslee. (Learning AWOD will usually take two separate encounters vs these mobs in APW)",
          "source_html": "<li>Ancient Word of Doom is learned in the APW Library Wing. Fight Dread Lords Malazath and Tiraslee. (Learning AWOD will usually take two separate encounters vs these mobs in APW)</li>",
          "preceding_heading": "Ancient Word of Doom",
          "review_status": "pending_semantic_review",
          "game_fact": false
        }
