      "prose_evidence": [
        {
          "block_index": 0,
          "tag": "p",
          "text_as_printed": "Shamans can specialize by choosing a Patron totem, which allows them to access special abilities and summon pets that are unique. These totems require undertaking a vision quest. The abilities include taking on the form of their totem spirit.",
          "source_html": "<p>Shamans can specialize by choosing a Patron totem, which allows them to access special abilities and summon pets that are unique. These totems require undertaking a vision quest. The abilities include taking on the form of their totem spirit.</p>",
          "preceding_heading": null,
          "review_status": "pending_semantic_review",
          "game_fact": false
        },
        {
          "block_index": 1,
          "tag": "p",
          "text_as_printed": "Tuurgin, the Bear Spirit, is a figure that represents the physical fury of the world, as well as its heartiness. As a follower of Tuurgin, the shaman is given a taste of the Bear, allowing him to use his body as an appendage of Tuurgin himself. By taking the form of the Bear, the shaman also takes on the Bear's tirelessness, and the Bear's fury, honing his transformed body into a living barrier against any who would stand in his way.",
          "source_html": "<p>Tuurgin, the Bear Spirit, is a figure that represents the physical fury of the world, as well as its heartiness. As a follower of Tuurgin, the shaman is given a taste of the Bear, allowing him to use his body as an appendage of Tuurgin himself. By taking the form of the Bear, the shaman also takes on the Bear's tirelessness, and the Bear's fury, honing his transformed body into a living barrier against any who would stand in his way.</p>",
          "preceding_heading": "Tuurgin (Bear)",
          "review_status": "pending_semantic_review",
          "game_fact": false
        },
        {
          "block_index": 2,
          "tag": "li",
          "text_as_printed": "Tuurgin Shaman Endowments",
          "source_html": "<li>Tuurgin Shaman Endowments</li>",
          "preceding_heading": "Tuurgin (Bear)",
          "review_status": "pending_semantic_review",
          "game_fact": false
        },
        {
          "block_index": 3,
          "tag": "p",
          "text_as_printed": "Balanced between melee and spell casting. Speed, dexterity and strength are gifts that Rakurr will grant you.",
          "source_html": "<p>Balanced between melee and spell casting. Speed, dexterity and strength are gifts that Rakurr will grant you.</p>",
          "preceding_heading": "Rakurr (Wolf)",
          "review_status": "pending_semantic_review",
          "game_fact": false
        },
        {
          "block_index": 4,
          "tag": "li",
          "text_as_printed": "Rakurr Shaman Endowments",
          "source_html": "<li>Rakurr Shaman Endowments</li>",
          "preceding_heading": "Rakurr (Wolf)",
          "review_status": "pending_semantic_review",
          "game_fact": false
        },
        {
          "block_index": 5,
          "tag": "p",
          "text_as_printed": "Fiery destruction. Shamans of Hayatet dislike engaging in melee combat and prefer to stand back and rain fire down on their foes.",
          "source_html": "<p>Fiery destruction. Shamans of Hayatet dislike engaging in melee combat and prefer to stand back and rain fire down on their foes.</p>",
          "preceding_heading": "Hayatet (Phoenix)",
          "review_status": "pending_semantic_review",
          "game_fact": false
        },
