# This repo lives inside a Vanguard: Saga of Heroes client install.
# Allow-list: ignore everything, then allow only the emulator's own files.
# Game client files are copyrighted by SOE/Daybreak and must never be committed.
/*
!/.gitignore
!/.github/
!/LICENSE
!/README.md
!/OVERNIGHT_BACKLOG.md
!/crowdsourced/
!/docs/
!/server/

# Local runtime data
/server/characters.json
/server/guilds.json
/server/brotherhoods.json
/server/stub_log.txt
/server/__pycache__/
*.pyc
/server/mail.json
/server/market.json
/server/bug_reports.json
/server/quest_feedback.json
/server/housing.json
/server/caravans.json
/server/civic.json
