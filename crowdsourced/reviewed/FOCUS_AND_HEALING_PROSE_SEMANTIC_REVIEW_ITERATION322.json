      "prose_evidence": [
        {
          "block_index": 0,
          "tag": "p",
          "text_as_printed": "The Blood Mage has three stances, called focuses.",
          "source_html": "<p>The Blood Mage has three stances, called focuses.</p>",
          "preceding_heading": null,
          "review_status": "pending_semantic_review",
          "game_fact": false
        },
        {
          "block_index": 1,
          "tag": "p",
          "text_as_printed": "This stance allows the blood mage to use all spells at their normal level. This is the starting focus.",
          "source_html": "<p>This stance allows the blood mage to use all spells at their normal level. This is the starting focus.</p>",
          "preceding_heading": "Unfocused",
          "review_status": "pending_semantic_review",
          "game_fact": false
        },
        {
          "block_index": 2,
          "tag": "p",
          "text_as_printed": "This form allows you to fortify yourself as you focus on healing others. This allows your heals to become more effective and you take less damage. Heals used on you, however, are much less effective and your damage is decreased greatly.",
          "source_html": "<p>This form allows you to fortify yourself as you focus on healing others. This allows your heals to become more effective and you take less damage. Heals used on you, however, are much less effective and your damage is decreased greatly.</p>",
          "preceding_heading": "Sanguine Focus",
          "review_status": "pending_semantic_review",
          "game_fact": false
        },
        {
          "block_index": 3,
          "tag": "li",
          "text_as_printed": "Adds a stacking hit point regen",
          "source_html": "<li>Adds a stacking hit point regen</li>",
          "preceding_heading": "Sanguine Focus",
          "review_status": "pending_semantic_review",
          "game_fact": false
        },
        {
          "block_index": 4,
          "tag": "li",
          "text_as_printed": "Heals you cast are increased by 25% effectiveness",
          "source_html": "<li>Heals you cast are increased by 25% effectiveness</li>",
          "preceding_heading": "Sanguine Focus",
          "review_status": "pending_semantic_review",
          "game_fact": false
        },
        {
          "block_index": 5,
          "tag": "li",
          "text_as_printed": "Your mitigation is increased by 15%",
          "source_html": "<li>Your mitigation is increased by 15%</li>",
          "preceding_heading": "Sanguine Focus",
          "review_status": "pending_semantic_review",
          "game_fact": false
        },
        {
          "block_index": 6,
          "tag": "li",
          "text_as_printed": "Your outgoing damage is reduced by 50%",
          "source_html": "<li>Your outgoing damage is reduced by 50%</li>",
          "preceding_heading": "Sanguine Focus",
          "review_status": "pending_semantic_review",
          "game_fact": false
        },
        {
          "block_index": 7,
          "tag": "p",
          "text_as_printed": "This form allows you to slowly trade your health for more power. As you lose health you gain increased damage, immunity to poison and disease and you gain an extra blood union with your opponent.",
          "source_html": "<p>This form allows you to slowly trade your health for more power. As you lose health you gain increased damage, immunity to poison and disease and you gain an extra blood union with your opponent.</p>",
          "preceding_heading": "Focus of Gelenia",
          "review_status": "pending_semantic_review",
          "game_fact": false
        },
        {
          "block_index": 8,
          "tag": "li",
          "text_as_printed": "You lose 5% of your health every 5 seconds",
          "source_html": "<li>You lose 5% of your health every 5 seconds</li>",
          "preceding_heading": "Focus of Gelenia",
          "review_status": "pending_semantic_review",
          "game_fact": false
        },
        {
          "block_index": 9,
          "tag": "li",
          "text_as_printed": "Add 25% Damage",
          "source_html": "<li>Add 25% Damage</li>",
          "preceding_heading": "Focus of Gelenia",
          "review_status": "pending_semantic_review",
          "game_fact": false
        },
        {
          "block_index": 10,
          "tag": "li",
          "text_as_printed": "You gain 1 Blood Union Point every 5 seconds",
          "source_html": "<li>You gain 1 Blood Union Point every 5 seconds</li>",
          "preceding_heading": "Focus of Gelenia",
